#!/usr/bin/env bash
# Blocks a push that would publish instructor solutions.
# Enable once per clone:   git config core.hooksPath .githooks
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
checker="$root/scripts/check_no_solutions.py"
[ -f "$checker" ] && command -v python3 >/dev/null 2>&1 || exit 0

status=0
zero="0000000000000000000000000000000000000000"

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue          # branch deletion
    if [ "$remote_sha" = "$zero" ]; then
        range=""                                    # new branch: content check only
    else
        range="$remote_sha..$local_sha"
    fi
    python3 "$checker" "$range" || status=1
done

if [ "$status" -ne 0 ]; then
    echo
    echo "pre-push hook refused this push."
    echo "If you are certain it is safe:  git push --no-verify"
fi
exit "$status"
